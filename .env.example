# Frontend development settings

# Sign-in page offers email verification codes and QQ login.
# Local login is only available in development, with lobby BYPASS_AUTH=true.
VITE_AUTH_MODE=email

# Lobby HTTP API. Leave empty to use the Vite proxy at /api.
# VITE_API_BASE_URL=http://localhost:8085/api

# Enable API mock fallback explicitly. Keep false for integration/production.
VITE_USE_MOCK=false

# Optional override. By default the game server supplies LIVEKIT_PUBLIC_URL.
# VITE_LIVEKIT_ENDPOINT=wss://voice.example.com

# Optional TRTC public SDK app id. Do not put TRTC_SECRET_KEY in frontend env.
VITE_TRTC_SDK_APP_ID=
